<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lời mời tham gia tổ chức - Dear Our Community</title>
</head>
<body style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; background-color: #f6f5fa; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f6f5fa; padding: 48px 0; width: 100%;">
        <tr>
            <td align="center">
                <!-- Outer Card -->
                <table width="500" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 40px rgba(143, 80, 226, 0.06); border: 1px solid #ede0ff; width: 500px; max-width: 100%;">
                    <!-- Top Gradient Accent Bar -->
                    <tr>
                        <td height="6" style="background: #8f50e2; background: linear-gradient(90deg, #8f50e2 0%, #c499ff 50%, #ff5101 100%); height: 6px; line-height: 6px; font-size: 1px;">&nbsp;</td>
                    </tr>
                    
                    <!-- Header Section -->
                    <tr>
                        <td align="center" style="padding: 36px 32px 24px; text-align: center;">
                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #8f50e2; display: block; margin-bottom: 12px; font-family: 'Inter', sans-serif;">DEAR OUR COMMUNITY</span>
                            <h1 style="margin: 0; color: #1c1c1c; font-size: 22px; font-weight: 700; letter-spacing: 0.5px; line-height: 1.3;">
                                Lời mời tham gia tổ chức
                            </h1>
                        </td>
                    </tr>
                    
                    <!-- Body Section -->
                    <tr>
                        <td style="padding: 0 32px 32px;">
                            <p style="margin: 0 0 16px; color: #1c1c1c; font-size: 15px; font-weight: 600; line-height: 1.5;">
                                Xin chào,
                            </p>
                            <p style="margin: 0 0 24px; color: #3a3a4e; font-size: 15px; line-height: 1.6;">
                                <strong>{{inviterName}}</strong> đã gửi lời mời tham gia và đồng hành cùng tổ chức <strong>{{organizationName}}</strong> trên nền tảng <strong>DearOurCommunity</strong>.
                            </p>
                            
                            <!-- Organization Callout Card -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #faf9fd; border: 1px solid #ede0ff; border-radius: 12px; padding: 24px; text-align: center; margin-bottom: 28px; width: 100%;">
                                <tr>
                                    <td align="center">
                                        <!-- Styled badge/avatar -->
                                        <div style="width: 56px; height: 56px; border-radius: 28px; background-color: #f5eeff; line-height: 58px; font-size: 24px; text-align: center; margin: 0 auto 12px; display: inline-block;">🏢</div>
                                        
                                        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #7a7a8e; display: block; margin-bottom: 6px;">TỔ CHỨC MỜI BẠN</span>
                                        <h3 style="margin: 0 0 6px; font-size: 18px; font-weight: 700; color: #8f50e2; letter-spacing: 0.2px;">
                                            {{organizationName}}
                                        </h3>
                                        <p style="margin: 0; font-size: 13px; color: #7a7a8e; line-height: 1.4;">
                                            Người gửi: <strong>{{inviterName}}</strong>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- CTA Button Section -->
                            <table cellpadding="0" cellspacing="0" style="margin: 0 auto 28px;">
                                <tr>
                                    <td align="center" style="background-color: #8f50e2; border-radius: 50px; box-shadow: 0 6px 16px rgba(143, 80, 226, 0.25);">
                                        <a href="{{inviteLink}}"
                                           style="display: inline-block; padding: 14px 40px; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; letter-spacing: 0.5px;">
                                            Xem và chấp nhận lời mời
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Information Expiry -->
                            <p style="margin: 0; color: #7a7a8e; font-size: 13px; line-height: 1.5; text-align: center;">
                                ⚠️ Liên kết này có hiệu lực trong vòng <strong>24 giờ</strong>.<br />
                                Nếu bạn không mong đợi email này, bạn có thể an toàn bỏ qua.
                            </p>
                        </td>
                    </tr>
                    
                    <!-- Footer Section -->
                    <tr>
                        <td style="padding: 24px 32px; text-align: center; border-top: 1px solid #e8e8ee; background-color: #fafafa;">
                            <p style="margin: 0; color: #a5a5b5; font-size: 12px; line-height: 1.5;">
                                <strong>DearOurCommunity</strong> — Nền tảng học tập cộng đồng
                            </p>
                            <p style="margin: 4px 0 0; color: #c4c4cf; font-size: 11px;">
                                &copy; 2026 DearOurCommunity. All rights reserved.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
